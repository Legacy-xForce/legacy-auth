DATABASE_URL=postgres://postgres:postgres@localhost:5432/legacy_auth
# In production (NODE_ENV=production) the service refuses to start with this value, with the key
# below, or with no value at all: generate your own (e.g. `openssl rand -hex 32`).
JWT_SECRET=super-secret-jwt-key
# EC P-256 private key in PEM format used to sign access tokens (ES256).
# Generate with: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# If unset, an ephemeral key is generated at startup (tokens are invalidated on restart).
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgGgQyaehoVvg00Qwk\nBv6y4uoEEROhwrsSq8jpvi5BIKChRANCAATPbSqU+iV1/JhngHtFLuYHVNbjrixc\ndspmM504fBUFH28hJ+xPCcKH7dGKO2mcjzY/n8BqAxMvG+bEXQgyfGXd\n-----END PRIVATE KEY-----
# Optional key ID override. Defaults to the RFC 7638 SHA-256 thumbprint of the public key.
JWT_KEY_ID=
# `iss` of access tokens; apps verifying them must expect the same value.
JWT_ISSUER=https://auth.legacy-group.tech
PORT=4000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
CACHE_TTL_MS=300000
# Directory where profile picture files are stored on disk
AVATAR_STORAGE_DIR=./data/avatars
# Maximum accepted upload size for profile pictures, in bytes
AVATAR_MAX_UPLOAD_BYTES=8388608
# Directory of the built frontend to serve as static files (default: ../frontend/dist).
# Uncomment to override; Docker sets this to /app/frontend/dist.
# FRONTEND_DIST_DIR=../frontend/dist
# Android apps allowed to use this host's passkeys, served as /.well-known/assetlinks.json:
# comma-separated <package>:<SHA-256 signing certificate fingerprint> entries.
# PASSKEY_ANDROID_APPS=com.legacy.legacytracker:AB:CD:...:EF
# Browser origins allowed to call the API (comma-separated). Unset allows any origin.
# CORS_ALLOWED_ORIGINS=https://calendar.legacy-group.tech,https://tracker.legacy-group.tech
# Failed sign-ins tolerated per username within the window (per IP: 5x) before 429.
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_SECONDS=900
# Read the client IP from X-Forwarded-For (only behind a trusted reverse proxy).
# TRUST_PROXY=true

# Reject login requests that do not name an app (`audience`). Turn on once every client sends it.
# REQUIRE_AUDIENCE=true
# auth_events rows older than this many days are deleted daily; 0 keeps them forever.
# AUDIT_RETENTION_DAYS=180

# --- OpenID Provider (see "OpenID Provider" in the README) ---
# Switch the OP off entirely; its paths answer 404 and nothing else changes. This is the rollback.
# OIDC_ENABLED=false
# Keys that sign the OP's cookies, newest first. Unset, one is derived from JWT_SECRET.
# OIDC_COOKIE_KEYS=
# A browser session ends after this long idle, or this long after sign-in, whichever is first.
# OIDC_SESSION_IDLE_SECONDS=1209600
# OIDC_SESSION_ABSOLUTE_SECONDS=2592000
# How long a client's previous secret keeps working after rotate-secret.
# OIDC_SECRET_ROTATION_GRACE_SECONDS=86400
# Back-channel logout retries: delays between attempts, and how often the queue is checked.
# OIDC_BACKCHANNEL_RETRY_DELAYS_MS=5000,30000,120000,600000,3600000
# OIDC_BACKCHANNEL_POLL_MS=2000
# Whether back-channel logout may call localhost or a private network. Off in production.
# OIDC_ALLOW_INTERNAL_BACKCHANNEL=true
